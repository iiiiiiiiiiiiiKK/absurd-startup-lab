  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "^0.21.5",
    "puppeteer-core": "^23.11.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
